d-soft:#FFF9ED;--radius:20px;--shadow:0 24px 48px -12px rgba(0,0,0,.12)}\n    body{background:var(--canvas);color:var(--ink);font-family:Inter,sans-serif}\n    .stage{padding:24px}.stage-shell{width:auto;max-width:980px;grid-template-columns:375px minmax(280px,1fr);gap:32px}.phone-wrap{top:24px}\n    .phone{width:375px;max-width:375px;height:812px;min-height:812px;border:12px solid var(--line);border-radius:48px;background:var(--ivory);box-shadow:var(--shadow)}\n    .phone::before{display:none}.app{height:100%;padding-top:48px}.status{height:48px;padding:10px 20px 0;font-size:11px;font-weight:600}.status-icons{gap:7px}\n    .screen-head{min-height:56px;padding:8px 16px;border:0;background:transparent;grid-template-columns:40px minmax(0,1fr) 40px;gap:8px}\n    .screen-head h1{font:400 18px/1.05 \"Playfair Display\",serif}.screen-head-brand{display:none}.header-tools{width:40px}.header-tools>*:not(:last-child){display:none}.header-avatar{display:none!important}\n    .icon-btn,.profile-control{width:40px;min-width:40px;height:40px;border:1px solid var(--line);border-radius:999px;background:#fff;box-shadow:none}\n    .root-head{min-height:56px;padding:8px 14px;grid-template-columns:30px minmax(0,1fr);gap:8px;border-bottom:1px solid var(--line);background:rgba(248,246,243,.96)}\n    .root-head .brand-lockup-mark{width:30px;height:30px;border:1px solid var(--gold);border-radius:999px;background:#fff;color:#9A6B18;font:500 10px/1 \"Playfair Display\",serif}\n    .global-search{height:38px;border:1px solid #D6CCC2;border-radius:14px;background:#fff;color:var(--faint);padding:0 12px;font-size:10px}.root-notification{display:none}\n    .app[data-screen=\"D-02\"]~.toast,.app[data-screen=\"C-01\"]~.toast,.app[data-screen=\"I-01\"]~.toast,.app[data-screen=\"K-01\"]~.toast,.app[data-screen=\"L-01\"]~.toast{bottom:82px}\n    .content{padding:10px 20px calc(92px + env(safe-area-inset-bottom));background:var(--ivory)}.content.no-nav{padding-bottom:24px}\n    .display{font:400 30px/1