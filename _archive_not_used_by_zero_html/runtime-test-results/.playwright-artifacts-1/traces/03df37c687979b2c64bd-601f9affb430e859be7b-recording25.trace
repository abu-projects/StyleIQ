round:#fff}.trip-context-summary b,.trip-context-summary small{display:block}.trip-context-summary small{margin-top:3px;color:var(--muted);font-size:8px}\n    :is(.card,.item-card,.signal-card,.muse-profile,.profile-closet,.profile-utility,.mirror-collage-card,.mirror-feed-card,.mirror-plan,.mirror-profile-preview,.settings-list,.preference-rows,.choice,.notes){background:var(--surface);box-shadow:0 8px 22px rgba(55,45,40,.06);backdrop-filter:none;-webkit-backdrop-filter:none}\n    .btn,.chip,.mirror-filter{background:#fff;box-shadow:none;backdrop-filter:none;-webkit-backdrop-filter:none}.btn.primary{background:var(--ink);box-shadow:none}.btn.gold{background:var(--accent);border-color:var(--accent);color:var(--text-primary);box-shadow:none}.screen-head,.root-head,.bottom-nav{background:rgba(248,246,243,.94);box-shadow:none;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}\n    .stage,.stage::before{background:var(--canvas)}.screen-head::before,.root-head::before,.bottom-nav::before,.card::after,.choice::after{display:none}\n    .head-muse{width:38px;height:38px;border:1px solid var(--line);border-radius:50%;background:var(--paper);display:grid;place-items:center}.head-muse .icon{width:17px;height:17px}.feedback-reasons{display:flex;flex-wrap:wrap;gap:8px}.saved-look-primary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;margin-top:14px}.saved-look-primary .btn{min-height:44px;padding:0 7px;font-size:11px}.muse-context-card{display:grid;grid-template-columns:38px 1fr;align-items:center;gap:10px;margin-top:14px;padding:12px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.muse-context-card .icon-wrap{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:var(--gold-soft);color:var(--gold)}.muse-context-card small{display:block;margin-top:3px;color:var(--muted);line-height:1.4}.studio-canonical{background:var(--ivory)}.studio-experience-switch{display:grid;grid-template-columns:1fr 1fr;gap:5px;margin:8px 0 12px;padding:4px;background:var(--canvas);border-radius:14px}.studio-experience-switch button{min-height:50px;border:0;border-radius:11px;background:transparent;display:grid;gap:2px;place-content:center}.studio-experience-switch button.active{background:var(--paper);box-shadow:0 2px 8px rgba(55,39,32,.08)}.studio-experience-switch small{font-size:8px;color:var(--muted)}.studio-simple-panel,.studio-create-panel{padding:16px 0}.studio-simple-actions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.studio-simple-actions button{min-height:76px;border:1px solid var(--line);border-radius:14px;background:var(--paper);padding:9px;display:grid;justify-items:start;align-content:space-between;text-align:left;font-size:10px}.studio-simple-actions span{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:var(--gold-soft);color:var(--gold)}.studio-simple-actions .icon{width:14px;height:14px}.studio-layer-row{display:grid;grid-template-columns:44px minmax(0,1fr) 30px 30px 30px;align-items:center;gap:7px;min-height:64px;border-bottom:1px solid var(--line)}.studio-layer-row img{width:44px;height:50px;object-fit:contain;background:var(--canvas);border-radius:9px}.studio-layer-row small{display:block;font-size:8px;color:var(--muted);margin-top:2px}.studio-layer-row button{width:30px;height:30px;border:1px solid var(--line);border-radius:50%;background:var(--paper);display:grid;place-items:center}.twin-step-bar{display:grid;grid-template-columns:repeat(4,1fr);gap:4px;margin-bottom:18px}.twin-step-bar span{padding-top:7px;border-top:3px solid var(--line);font-size:7px;color:var(--faint)}.twin-step-bar span.on{border-color:var(--gold);color:var(--ink)}.twin-reference-pair{display:grid;grid-template-columns:1fr 1fr;gap:10px}.twin-reference-pair .mirror-upload-guide{height:250px;width:100%;border:1px solid var(--line);padding:0}.twin-reference-pair .mirror-upload-guide img{height:100%;object-fit:cover}\n    .visual-sea