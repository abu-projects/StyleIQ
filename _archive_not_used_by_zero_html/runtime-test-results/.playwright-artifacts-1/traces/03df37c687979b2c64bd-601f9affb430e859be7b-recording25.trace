n{border-radius:10px;background:#2b2320}.source-tabs,.trip-tabs{border-radius:10px}.source-tabs button,.trip-tabs button{border-radius:7px}\n    .studio-screen,.studio-header,.studio-scroll,.studio-context{background:#181412}.studio-canvas{background:#e8e3dd}\n    .studio-special{background:#211c19;border-color:#3c332f;border-radius:9px}.studio-tool,.studio-context-pill{border-radius:6px}\n    .studio-save,.studio-back,.studio-avatar-cta,.studio-add{border-radius:9px}.lane-tile{background:#302925;border-color:#554942}\n    .entry-splash,.walkthrough-dark{background:#211b18}.splash-tint{background:rgba(28,22,19,.49)}\n    .styling-option{border-radius:10px}.styling-option img{border-radius:6px}\n    button,a,.card,.item-card{transition:transform 180ms ease,background-color 180ms ease,border-color 180ms ease}\n    button:hover,.item-card:hover{border-color:#aa9990}.btn:hover{transform:translateY(-1px)}\n    @media(max-width:860px){.phone{border-radius:0}.content{padding-left:18px;padding-right:18px}}\n\n    /* Component language borrowed from the original index experience. */\n    .stage-shell{grid-template-columns:minmax(375px,390px) minmax(280px,1fr);max-width:980px}\n    .phone{max-width:390px;height:min(844px,calc(100dvh - 48px))}\n    .root-head{min-height:62px;padding:8px 18px;grid-template-columns:44px minmax(0,1fr) 44px;gap:9px}\n    .root-head .brand-lockup-mark{width:44px;height:44px;font-size:9px;background:var(--paper);color:var(--ink);border-color:var(--line)}\n    .global-search{height:44px;min-width:0;border:1px solid var(--line);border-radius:12px;background:var(--paper);color:var(--faint);padding:0 12px;display:flex;align-items:center;gap:8px;text-align:left;font-size:10px}\n    .global-search .icon{width:15px;height:15px;color:var(--muted)}\n    .root-notification{position:relative;width:44px;height:44px;border:0;background:transparent;display:grid;place-items:center}\n    .root-notification .icon{width:18px;height:18px}.root-notification .notification-dot{right:4px;top:3px}\n    .home-greeting{display:grid;grid-template-columns:1fr auto;align-items:center;gap:14px}\n    .home-greeting .display{font-size:31px;line-height:1.02;margin-top:4px;max-width:10ch}\n    .muse-entry{display:flex;align-items:center;gap:7px;border:0;background:transparent;padding:0;color:var(--ink);font-size:10px;font-weight:750;text-align:left}\n    .muse-entry img{width:42px;height:42px;border-radius:12px;object-fit:cover;object-position:center 20%}\n    .home-context{display:flex;align-items:center;gap:7px;margin-top:3px;color:var(--muted);font-size:10px}\n    .home-context span+span::before{content:\"·\";margin-right:7px;color:var(--faint)}\n    .daily-look{position:relative;margin-top:13px;border-radius:18px;overflow:hidden;background:#d8cec4}\n    .daily-look>img{width:100%;height:318px;object-fit:cover;object-position:center 37%}\n    .daily-look-badge{position:absolute;left:12px;top:12px;min-height:27px;padding:0 9px;border:1px solid rgba(255,255,255,.7);border-radius:8px;background:rgba(251,248,243,.9);display:flex;align-items:center;font-size:9px;font-weight:750;color:var(--ink)}\n    .daily-look-save{position:absolute;right:12px;top:12px;width:36px;height:36px;border:1px solid rgba(255,255,255,.72);border-radius:10px;background:rgba(251,248,243,.92);display:grid;place-items:center}\n    .daily-look-save .icon{width:17px;height:17px}.daily-look-count{position:absolute;right:13px;bottom:12px;border-radius:7px;background:rgba(251,248,243,.9);padding:5px 8px;font-size:9px;font-weight:750}\n    .closet-strip{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(76px,1fr);gap:7px;overflow-x:auto;margin-top:8px;padding-bottom:2px;scrollbar-width:none}\n    .closet-piece{border:0;background:transparent;padding:0;text-align:left;min-width:0}.closet-piece-media{position:relative;height:82px;border-radius:12px;overflow:hidden;background:#ebe5de}\n    .closet-piece-media img{width:100%;height:100%;object-fit:contain}.closet-piece-medi