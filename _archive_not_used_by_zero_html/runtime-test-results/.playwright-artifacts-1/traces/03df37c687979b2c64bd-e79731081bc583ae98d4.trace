text-align:left;min-height:146px}.styling-option img{width:100%;height:98px;object-fit:cover;object-position:top;border-radius:12px;background:var(--canvas)}.styling-option b{display:block;font-size:11px;padding:9px 4px 3px}.styling-option[aria-pressed=\"true\"]{border-color:var(--gold);box-shadow:inset 0 0 0 1px var(--gold)}.styling-option[aria-pressed=\"true\"]::after{content:\"✓\";position:absolute;top:13px;right:13px;width:24px;height:24px;border-radius:50%;display:grid;place-items:center;background:var(--ink);color:#fff;font-size:11px}.studio-header-row .brand-lockup{margin:0 auto}.studio-header-row .studio-save{margin-left:0}\n    .floating-index[hidden]{display:none!important}.walkthrough-dark .btn{background:#fff;color:var(--ink);border-color:#fff}\n\n    /* 2026 editorial refresh — original StyleIQ restraint with Alta's product depth. */\n    :root{\n      --ivory:#f5f1eb;--canvas:#e9e3dc;--paper:#fbf8f3;--ink:#241d1a;\n      --muted:#716761;--faint:#9c918a;--line:#d8cfc6;\n      --gold:#c89b45;--gold-soft:#f5ead2;--danger:#8e2934;--green:#3f6455;\n      --radius:14px;--shadow:0 24px 70px rgba(55,39,32,.14)\n    }\n    body{background-color:var(--canvas);background-image:none}\n    .rail{background:#211b18;border-right-color:rgba(255,255,255,.07)}\n    .rail-head{padding-top:28px}.mark,.brand-lockup-mark{border-radius:3px;border-color:#b9a49c;color:#efe8e1}\n    .section-label{background:#211b18;color:#c89b45;letter-spacing:.08em}\n    .screen-link b,.screen-head-brand,.eyebrow,.settings-section-label,.menu-group-label{color:var(--gold)}\n    .progress-line span,.evolution-bar span{background:var(--gold)}\n    .screen-link[aria-current=\"page\"]{box-shadow:inset 2px 0 #c5a59f;background:rgba(255,255,255,.075)}\n    .phone{border-color:#26211f;border-radius:42px;box-shadow:0 32px 72px rgba(48,34,28,.18)}\n    .phone::before{background:#26211f}\n    .screen-head{background:rgba(245,241,235,.94);border-bottom-color:rgba(95,75,66,.16)}\n    .content{padding-left:20px;padding-right:20px}\n    .display{font-size:37px;line-height:.98;letter-spacing:-.035em}.title{letter-spacing:-.025em}\n    .eyebrow{font-size:9px;letter-spacing:.105em}.body{line-height:1.6}\n    .card,.item-card,.signal-card,.muse-profile{border-radius:var(--radius);box-shadow:none}\n    .btn{border-radius:10px;min-height:46px}.btn.primary{background:#2b2320;border-color:#2b2320}\n    .btn.gold{background:var(--gold);border-color:var(--gold)}\n    .icon-btn{min-width:44px;height:44px;border-radius:10px}.header-tool{width:40px;height:44px}.chip{border-radius:7px}.chip.active,.chip[aria-pressed=\"true\"]{background:#2b2320;border-color:#2b2320}\n    .choice{min-height:60px;border-radius:10px;background:transparent}.choice.selected{background:var(--paper);box-shadow:inset 3px 0 var(--gold)}\n    .pill,.phase-pill{border-radius:4px}.pill.gold,.phase-pill{background:var(--gold-soft);color:var(--gold)}\n    .bottom-nav{background:rgba(251,248,243,.96)}.nav-btn.add .nav-icon{background:var(--gold);border-radius:10px}\n    .header-avatar img,.profile-summary img,.muse-profile-head img,.muse-identity img,.account-menu-head img{border-radius:14px}\n    .profile-summary{grid-template-columns:88px 1fr}.profile-summary img{width:88px;height:104px;object-position:center 22%}\n    .profile-stat{padding:16px 4px}.profile-stat b{font-family:\"Playfair Display\",Georgia,serif;font-size:22px;font-weight:400}\n    .hero-img,.muse-look{border-radius:10px}.muse-spotlight{border-radius:12px;background:#2a211e}\n    .muse-look{height:244px;object-position:center 40%}.muse-spotlight-copy{padding:17px 16px 18px}\n    .muse-actions .btn{border-radius:9px}.signal-card .icon-wrap,.reason-row .icon-wrap,.select-row .icon-wrap{border-radius:8px;background:var(--gold-soft);color:var(--gold)}\n    .item-card img{height:190px}.item-card .copy{padding:11px 12px 13px}\n    .notes{border-radius:16px;background:rgba(251,248,243,.72)}.notes h2{letter-spacing:-.03em}\n    .settings-hero-icon{border-radius:10px;background:#2b2320}.source-tabs,.trip-tabs{border-radius:10px}.source-tabs button,.trip-tabs button{border-radius:7px}\n    .studio-screen,.studio-header,.studio-scroll,.studio-context{background:#181412}.studio-canvas{background:#e8e3dd}\n    .studio-special{background:#211c19;border-color:#3c332f;border-radius:9px}.studio-tool,.studio-context-pill{border-radius:6px}\n    .studio-save,.studio-back,.studio-avatar-cta,.studio-add{border-radius:9px}.lane-tile{background:#302925;border-color:#554942}\n    .entry-splash,.walkthrough-dark{background:#211b18}.splash-tint{background:rgba(28,22,19,.49)}\n    .styling-option{border-radius:10px}.styling-option img{border-radius:6px}\n    button,a,.card,.item-card{transition:transform 180ms ease,background-color 180ms ease,border-color 180ms ease}\n    button:hover,.item-card:hover{border-color:#aa9990}.btn:hover{transform:translateY(-1px)}\n    @media(max-width:860px){.phone{border-radius:0}.content{padding-left:18px;padding-right:18px}}\n\n    /* Component language borrowed from the original index experience. */\n    .stage-shell{grid-template-columns:minmax(375px,390px) minmax(280px,1fr);max-width:980px}\n    .phone{max-width:390px;height:min(844px,calc(100dvh - 48px))}\n    .root-head{min-height:62px;padding:8px 18px;grid-template-columns:44px minmax(0,1fr) 44px;gap:9px}\n    .root-head .brand-lockup-mark{width:44px;height:44px;font-size:9px;background:var(--paper);color:var(--ink);border-color:var(--line)}\n    .global-search{height:44px;min-width:0;border:1px solid var(--line);border-radius:12px;background:var(--paper);color:var(--faint);padding:0 12px;display:flex;align-items:center;gap:8px;text-align:left;font-size:10px}\n    .global-search .icon{width:15px;height:15px;color:var(--muted)}\n    .root-notification{position:relative;width:44px;height:44px;border:0;background:transparent;display:grid;place-items:center}\n    .root-notification .icon{width:18px;height:18px}.root-notification .notification-dot{right:4px;top:3px}\n    .home-greeting{display:grid;grid-template-columns:1fr auto;align-items:center;gap:14px}\n    .home-greeting .display{font-size:31px;line-height:1.02;margin-top:4px;max-width:10ch}\n    .muse-entry{display:flex;align-items:center;gap:7px;border:0;background:transparent;padding:0;color:var(--ink);font-size:10px;font-weight:750;text-align:left}\n    .muse-entry img{width:42px;height:42px;border-radius:12px;object-fit:cover;object-position:center 20%}\n    .home-context{display:flex;align-items:center;gap:7px;margin-top:3px;color:var(--muted);font-size:10px}\n    .home-context span+span::before{content:\"·\";margin-right:7px;color:var(--faint)}\n    .daily-look{position:relative;margin-top:13px;border-radius:18px;overflow:hidden;background:#d8cec4}\n    .daily-look>img{width:100%;height:318px;object-fit:cover;object-position:center 37%}\n    .daily-look-badge{position:absolute;left:12px;top:12px;min-height:27px;padding:0 9px;border:1px solid rgba(255,255,255,.7);border-radius:8px;background:rgba(251,248,243,.9);display:flex;align-items:center;font-size:9px;font-weight:750;color:var(--ink)}\n    .daily-look-save{position:absolute;right:12px;top:12px;width:36px;height:36px;border:1px solid rgba(255,255,255,.72);border-radius:10px;background:rgba(251,248,243,.92);display:grid;place-items:center}\n    .daily-look-save .icon{width:17px;height:17px}.daily-look-count{position:absolute;right:13px;bottom:12px;border-radius:7px;background:rgba(251,248,243,.9);padding:5px 8px;font-size:9px;font-weight:750}\n    .closet-strip{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(76px,1fr);gap:7px;overflow-x:auto;margin-top:8px;padding-bottom:2px;scrollbar-width:none}\n    .closet-piece{border:0;background:transparent;padding:0;text-align:left;min-width:0}.closet-piece-media{position:relative;height:82px;border-radius:12px;overflow:hidden;background:#ebe5de}\n    .closet-piece-media img{width:100%;height:100%;object-fit:contain}.closet-piece-media em{position:absolute;left:5px;bottom:5px;border-radius:4px;background:rgba(251,248,243,.92);padding:3px 5px;color:var(--gold);font-size:7px;font-style:normal;font-weight:800}\n    .closet-piece b{display:block;margin-top:6px;font-size:8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.closet-piece small{display:block;color:var(--muted);font-size:7px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n    .closet-progress{display:flex;justify-content:space-between;align-items:center;margin-top:8px;font-size:10px}.closet-progress b{font-variant-numeric:tabular-nums}.closet-progress button{border:0;background:transparent;color:var(--muted);font-size:9px}\n    .home-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}.home-actions .btn{min-width:0}\n    .profile-kicker{display:flex;align-items:center;justify-content:space-between}.profile-kicker .title{font-size:20px}\n    .profile-control{width:38px;height:38px;border:1px solid var(--line);border-radius:12px;background:var(--paper);display:grid;place-items:center}.profile-control .icon{width:17px;height:17px}\n    .profile-editorial{display:grid;grid-template-columns:64px 1fr auto;align-items:center;gap:12px;margin-top:18px}\n    .profile-editorial img{width:64px;height:76px;border-radius:14px;object-fit:cover;object-position:center 22%}\n    .profile-editorial .title{font-size:29px;margin:2px 0}.profile-editorial .body{font-size:10px}\n    .profile-looks-head{display:flex;align-items:flex-end;justify-content:space-between;margin-top:23px}.profile-looks-head .title{font-size:25px;margin-bottom:0}.text-action{border:0;background:transparent;padding:5px 0;font-size:9px;font-weight:800}\n    .profile-look-rail{display:grid;grid-auto-flow:column;grid-auto-columns:42%;gap:8px;overflow-x:auto;margin:11px -20px 0;padding:0 20px 4px;scrollbar-width:none}\n    .profile-look{position:relative;height:194px;border:0;border-radius:16px;overflow:hidden;background:var(--canvas);padding:0;text-align:left;color:#fff}\n    .profile-look img{width:100%;height:100%;object-fit:cover}.profile-look::after{content:\"\";position:absolute;inset:58% 0 0;background:rgba(28,22,19,.72)}\n    .profile-look span{position:absolute;z-index:1;left:11px;right:8px;bottom:10px;font-size:10px}.profile-look b{display:block;margin-top:3px;font-family:\"Playfair Display\",Georgia,serif;font-size:17px;font-weight:400}\n    .profile-closet{margin-top:16px;padding:15px;border:1px solid var(--line);border-radius:16px;background:var(--paper)}\n    .profile-closet-row{display:grid;grid-template-columns:58px 1fr auto;align-items:center;gap:11px;margin-top:12px}.profile-closet-row img{width:58px;height:67px;border-radius:10px;object-fit:contain;background:var(--canvas)}\n    .profile-closet-row .btn{min-height:36px;padding:0 11px;font-size:9px}\n    .profile-utility-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px}.profile-utility{min-width:0;border:1px solid var(--line);border-radius:14px;background:transparent;padding:10px;text-align:left}\n    .profile-utility img{width:100%;height:88px;border-radius:9px;object-fit:cover;background:var(--canvas)}.profile-utility b{display:block;margin-top:8px;font-family:\"Playfair Display\",Georgia,serif;font-size:16px;font-weight:400}.profile-utility small{display:block;color:var(--muted);font-size:8px;line-height:1.35;margin-top:2px}\n    .outfit-preview{height:326px;border-radius:16px;background:var(--canvas)}.outfit-preview .outfit-full{width:100%;height:100%;object-fit:cover;object-position:center 48%}\n    .outfit-preview-tag{position:absolute;left:11px;top:11px;z-index:1;border-radius:5px;background:rgba(251,248,243,.92);padding:5px 7px;color:var(--ink);font-size:8px;font-weight:800}\n    .outfit-preview-count{position:absolute;right:11px;bottom:11px;z-index:1;border-radius:5px;background:rgba(251,248,243,.92);padding:5px 7px;font-size:8px;font-weight:800}\n    .outfit-meta{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-top:11px}.outfit-meta .title{font-size:22px;margin:2px 0}.outfit-meta .body{font-size:10px}\n    .outfit-primary-actions{display:grid;grid-template-columns:1.15fr .85fr;gap:8px;margin-top:11px}.outfit-primary-actions .btn{min-width:0}\n    .outfit-secondary-actions{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:8px}.outfit-secondary-actions .action-btn{height:38px;border-radius:9px;font-size:9px;display:flex;gap:6px}\n    .feed-card{border:0;border-radius:13px;background:transparent}.feed-card img{border-radius:13px}.feed-card p{padding:7px 2px 9px;text-align:left}\n    .empty{min-height:330px;padding:24px 18px}.empty-art{width:112px;height:112px;background:var(--gold-soft)}.empty-art img{width:88px;height:88px}\n    .trip-empty-visual{width:100%;height:248px;border-radius:16px;object-fit:cover;object-position:center 42%;margin-bottom:18px}\n    .text-action{min-height:44px;padding:0 6px}.profile-control,.daily-look-save,.root-notification{width:44px;height:44px}.root-head{grid-template-columns:34px minmax(0,1fr) 44px}.global-search{height:44px}\n    .closet-wishlist-intro{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;margin:18px 0 10px}.closet-wishlist-intro .title{margin-bottom:0}.wishlist-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.wishlist-grid .item-card img{height:178px;object-fit:contain}\n    .planner-day-focus{margin-top:18px;padding:15px 0 0;border-top:1px solid var(--line)}.planner-day-focus .title{font-size:24px}.planner-day-focus-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:13px}.planner-day-focus-actions>:only-child{grid-column:1/-1}\n    .planner-day-preview{width:100%;height:180px;border-radius:14px;object-fit:cover;margin-top:12px}\n    .twin-editorial-visual{position:relative;display:block;width:100%;height:330px;margin:0;border-radius:16px;overflow:hidden;background:var(--canvas)}.twin-editorial-visual img{display:block;width:100%;hei