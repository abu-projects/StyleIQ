backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px)}\n    .sheet,.notifications-sheet,.account-menu{border:1px solid rgba(255,255,255,.72);border-radius:28px 28px 36px 36px;background:linear-gradient(145deg,rgba(255,255,255,.78),rgba(255,253,250,.52));box-shadow:0 -12px 48px rgba(0,0,0,.2),inset 0 1px rgba(255,255,255,.96),inset 0 -1px rgba(200,155,69,.1);backdrop-filter:blur(24px) saturate(165%);-webkit-backdrop-filter:blur(24px) saturate(165%);animation:sheet-enter 420ms cubic-bezier(.22,1,.36,1) both}\n    @keyframes sheet-enter{from{opacity:.55;transform:translateY(42px) scale(.985)}to{opacity:1;transform:none}}\n    .grab{width:36px;height:5px;background:rgba(60,60,67,.3)}\n    .modal{border:1px solid rgba(255,255,255,.72);border-radius:26px;background:linear-gradient(145deg,rgba(255,255,255,.8),rgba(255,253,250,.5));box-shadow:inset 0 1px rgba(255,255,255,.96),0 18px 50px rgba(27,23,22,.18);backdrop-filter:blur(24px) saturate(165%);-webkit-backdrop-filter:blur(24px) saturate(165%)}\n    .notes{border:1px solid rgba(255,255,255,.78);border-radius:24px;background:linear-gradient(145deg,rgba(255,255,255,.64),rgba(255,253,250,.3));box-shadow:inset 0 1px rgba(255,255,255,.94),0 14px 38px rgba(73,57,45,.09);backdrop-filter:blur(18px) saturate(145%);-webkit-backdrop-filter:blur(18px) saturate(145%)}\n    .notes h2{font-size:28px;font-weight:700;letter-spacing:-.03em}\n    .metric{border-top-color:var(--line)}\n    .kbd{background:rgba(255,255,255,.7);border-color:var(--line)}\n\n    .studio-screen,.studio-header,.studio-scroll,.studio-context{background:#000;color:#f5f5f7}\n    .studio-header{border-bottom:1px solid rgba(255,255,255,.12)}\n    .studio-back,.studio-save{border:0;background:rgba(118,118,128,.28);color:#fff}\n    .studio-save{background:var(--gold);color:#fff}\n    .studio-title{color:#fff;font-size:22px;font-weight:700;letter-spacing:-.025em}\n    .studio-canvas{border:0;border-radius:20px;background:#1c1c1e}\n    .studio-modebar{background:rgb